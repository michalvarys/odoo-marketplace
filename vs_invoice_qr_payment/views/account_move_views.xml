<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_move_form_inherit_qr_payment" model="ir.ui.view">
        <field name="name">account.move.form.inherit.qr.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group string="SPAYD QR Payment" invisible="not vs_qr_payment_image">
                    <field name="vs_qr_payment_data" invisible="1"/>
                    <field name="vs_qr_payment_image"
                           widget="image"
                           string="QR Platba"
                           nolabel="1"
                           colspan="2"
                           options="{'size': [200, 200]}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
